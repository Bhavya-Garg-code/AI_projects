import requests
hfapi = 'MYAPIKEY'
url = "https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2"

headers = {
    'Authorization': f'Bearer {hfapi}'
}

while True:
    s1 = input("Enter first sentence: ")
    if s1.lower() == 'exit':
        print("Exiting.....")
        break

    s2 = input("Enter second sentence: ")
    if s2.lower() == 'exit':
        print("Exiting.....")
        break

    payload = {
        'inputs':{
            'source_sentence':s1,
            'sentences':[s2]
        }
    }

    send = requests.post(url,headers=headers,json = payload)
    if(send.ok):
        score = send.json()[0]
        print(f"score : {score:.2%}")
        
        if(score >= 0.72):
            print("Duplicate")
        else:
            print("Different")
    else:
        print("Error Occured")
        print(send.text)
