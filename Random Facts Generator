import requests

print("Welocome to random facts generator")
print('1. English (en)')
print('2. German (de)')
lang = input("Enter your preffered language code: ")
if(lang in ['en','de']):
    url = f'https://uselessfacts.jsph.pl/api/v2/facts/random?language={lang}'
    def facts():
        response = requests.get(url)
        if(response.status_code == 200):
            fact = response.json()
            print(f'Facts: {fact["text"]}')
        else:
            print("Error occured, failed to generate the facts")
else:
    print("invalid language code given..")


while True:
    
    inp = input("Press enter to generate random facts in your preffered language or press q to quit: " ).strip().lower()
    if(inp == 'q'):
        print("Quitting....")
        break
    else:
        facts()
