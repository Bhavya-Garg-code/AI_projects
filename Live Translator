import pyttsx3
from googletrans import Translator

def speak(text):
    engine = pyttsx3.init()
    engine.setProperty('rate',150)
    voices = engine.getProperty('voices')
    engine.setProperty('voices',voices[0].id)
    engine.say(text)
    engine.runAndWait()

def translator(text,lang):
    transla = Translator()
    a = transla.translate(
        text,
        dest =lang
    )
    print('Translated: ',a.text)
    return a.text

def availabe_languages():
    print("The given languages are available for translation")
    print('1. French(fr)')
    print('2. German(de)')
    print('3. Hindi(hi)')
    print('4. Punjabi(pa)')
    print('5. Italian(it)')

    inp = input("Enter your choice of language(1-5): ")
    choice = {
        '1':'fr',
        '2':'de',
        '3':'hi',
        '4':'pa',
        '5':'it'
    }
    return choice.get(inp, 'fr')

def main():
    target_lang = availabe_languages()
    user = input("Enter your text: ")
    if user:
        tr = translator(user,target_lang)
        speak(tr)
        print("Translation completed!!")

main()
