import requests

url = 'https://official-joke-api.appspot.com/random_joke'

def jokes():
    data = requests.get(url)
    if(data.status_code == 200):
        joke = data.json()
        print("Today's joke is :")
        print(f'{joke["setup"]}  {joke["punchline"]}')
    else:
        print("Error occured")

while True:
    inp = input("Press enter to generate a random joke or q to quit: ")
    if(input):
        jokes()
    elif(input == 'q'):
        print("Exiting...")
        break
    else:
        print("Error occured")
