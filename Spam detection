import gradio as gr

spam_words = {
    'free': 1, 'claim':1, 'urgent':2, 'cash':3, 'Click':2, 'offer':2, 'limited':1, 'account':1, 'won':2, 'prize':2, 'congratulations': 1, 'winner':2, 'lottery':3, 'offer': 3
}
threshold = 4
def check(mess):
    words = mess.lower().split()
    flagged = []
    for word in words:
        word = word.strip(":,.!?/:;'\"")
        if(word in spam_words):
            flagged.append(word)

    score = sum(spam_words[word] for word in flagged)
    result = 'Spam' if score >= threshold else 'Safe'
    return result, score, ', '.join(flagged)

app = gr.Interface(fn = check, inputs= gr.Textbox(lines = 2, label = 'Enter your message'), outputs = [gr.Textbox(lines = 3, label = 'Verdict'), gr.Number(label = 'Spam score'), gr.Textbox(label = 'flagged words')], title = 'Spam Shield', description = "Let's detect spams ", examples = [['Congratulations! You won a cash prize'], ['Hi, are we meetign today'], ['Click the given link to claim your prize']])

app.launch()
